/**
 * การตั้งค่า Cloudflare Worker ของ MU Esport Staff
 * - ส่วนบนสุดใช้กับการพัฒนาในเครื่อง (D1 local ใน .wrangler/) ไม่ผูกกับฐานข้อมูลจริง
 * - env.staging / env.production ต้องใส่ database_id ของตัวเองก่อน deploy (ดู README)
 * - ค่าลับ (GOOGLE_CLIENT_SECRET, TOKEN_ENCRYPTION_KEY) ไม่อยู่ในไฟล์นี้ ใช้ .dev.vars ในเครื่อง และ Worker Secrets บน Cloudflare
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mu-esport-staff",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/auth/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "PASSWORD_HASH_MODE": "client",
    "CLUB_GOOGLE_EMAIL": "muesport2567@gmail.com",
    "GOOGLE_CLIENT_ID": "",
    // Google Picker (เลือกไฟล์เดิมจากหน้าเว็บ): API key ของเบราว์เซอร์และเลขโครงการ Google Cloud ไม่ใช่ค่าลับ เว้นว่าง = ยังเลือกไฟล์เดิมไม่ได้ (ดู README)
    "GOOGLE_PICKER_API_KEY": "AIzaSyBM0aU1cZlusCpOtCT7XvOgiA87sBnMu0Q",
    "GOOGLE_CLOUD_PROJECT_NUMBER": "989576232237"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mu-esport-staff-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "mu-esport-staff-staging",
      "vars": {
        "PASSWORD_HASH_MODE": "client",
        "CLUB_GOOGLE_EMAIL": "muesport2567@gmail.com",
        "GOOGLE_CLIENT_ID": "REPLACE_WITH_STAGING_GOOGLE_CLIENT_ID",
        "GOOGLE_PICKER_API_KEY": "",
        "GOOGLE_CLOUD_PROJECT_NUMBER": ""
      },
      // Cron ของ staging แยกจาก production: อัปเดตสำเนาจาก Google ทุก 15 นาที
      "triggers": {
        "crons": [
          "*/15 * * * *"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mu-esport-staff-staging",
          "database_id": "REPLACE_WITH_STAGING_D1_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "muesportbackend",
      "vars": {
        "PASSWORD_HASH_MODE": "client",
        "CLUB_GOOGLE_EMAIL": "muesport2567@gmail.com",
        "GOOGLE_CLIENT_ID": "989576232237-3c083cakvsrl2ktrqqvacqsj2c000rgi.apps.googleusercontent.com",
        // ใส่ API key ของ Picker หลังสร้างใน Google Cloud (ดู README หัวข้อ Google Picker)
        "GOOGLE_PICKER_API_KEY": "AIzaSyBM0aU1cZlusCpOtCT7XvOgiA87sBnMu0Q",
        // เลขโครงการ = ส่วนหน้าของ OAuth client ID
        "GOOGLE_CLOUD_PROJECT_NUMBER": "989576232237"
      },
      // อัปเดตสำเนาจาก Google ทุก 5 นาทีแม้ไม่มีใครเปิดเว็บ (ขณะมีคนเปิดหน้า หน้าเว็บตรวจเองทุกประมาณ 60 วินาที)
      "triggers": {
        "crons": [
          "*/5 * * * *"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mu-esport-backend-production",
          "database_id": "bae930b3-d8a7-486e-90ad-c7f7497aba6e",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
